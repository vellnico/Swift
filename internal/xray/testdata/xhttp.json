{
  "log": {
    "loglevel": "warning",
    "access": "none",
    "dnsLog": false
  },
  "api": {
    "tag": "api",
    "listen": "127.0.0.1:10085",
    "services": [
      "HandlerService",
      "StatsService"
    ]
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 2,
        "downlinkOnly": 5
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "inbounds": [
    {
      "tag": "p2",
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "6f1b0b8e-6d1f-4a7e-9a52-1b2f3c4d5e6f",
            "email": "u1"
          },
          {
            "id": "0a9c8b7d-5e4f-4321-8abc-def012345678",
            "email": "u2"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "www.apple.com:443",
          "xver": 0,
          "serverNames": [
            "www.apple.com"
          ],
          "privateKey": "8Pf3Vq0Lr8HbW2n2RjKq3xS1o9vY6aZcD4eFgHiJk2w",
          "shortIds": [
            "9988776655443322"
          ]
        },
        "xhttpSettings": {
          "path": "/k3j9x2m4",
          "mode": "auto"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "block"
      }
    ]
  }
}
